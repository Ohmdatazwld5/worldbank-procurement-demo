# Input rows below are clearly synthetic demonstration fixtures, not World Bank
# procurement records. Replace them with licensed/reviewed real procurement data.
PROCUREMENT_DATA_PATH=examples/procurement_demo.csv
# Add only reviewer-approved contract snapshot updates (including new milestones
# and amendments); each row needs review_status, reviewed_by, reviewed_at,
# source_uri, and a stable contract/tender identifier.
# APPROVED_CONTRACT_UPDATE_FEEDS=data/approved_contract_updates.csv
DOCUMENTS_DIR=examples/documents
DOCUMENT_MANIFEST_PATH=examples/document_manifest.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional API source after the pipeline has created these Delta tables. The
# pipeline itself defaults to ./data/lakehouse when this is unset.
# DELTA_LAKE_ROOT=./data/lakehouse
CATALOG_MODE=hive
# For Nessie, also set NESSIE_URI, NESSIE_REF, NESSIE_WAREHOUSE,
# NESSIE_SPARK_PACKAGES with Spark/Scala-compatible Maven coordinates.
# Hive uses Spark's embedded metastore by default; set this for a shared metastore:
# HIVE_METASTORE_URIS=thrift://hive-metastore:9083

WORLD_BANK_COUNTRIES=IND,USA,CHN
WORLD_BANK_START_YEAR=2015
WORLD_BANK_END_YEAR=2025
APP_LOG_PATH=logs/application.jsonl
FEEDBACK_JSONL_PATH=data/feedback.jsonl
PREDICTION_LOG_PATH=data/predictions.jsonl

# Replace demo tokens and use a managed secret store / OIDC gateway outside a demo.
API_TOKENS_JSON='{"demo-admin":{"subject":"demo-admin","roles":["admin"],"project_ids":["*"]},"demo-analyst":{"subject":"demo-analyst","roles":["analyst"],"project_ids":["P001","P002","P005"]}}'

# Configure registered model URIs after evaluation and human approval.
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_MODEL_TIMELINE_URI=models:/worldbank_demo.timeline_days/1
# MLFLOW_MODEL_AMENDMENT_URI=models:/worldbank_demo.amendment_probability/1
# MLFLOW_MODEL_REBID_URI=models:/worldbank_demo.rebid_probability/1
# MODEL_REGISTRY_PREFIX=worldbank_demo
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Airflow-only inputs. Reference data must be a reviewed baseline.
# DRIFT_REFERENCE_DATA_PATH=examples/procurement_reference.csv
# EVAL_CASES_PATH=examples/evaluation_cases.json
# MODEL_DRIFT_REFERENCE_DATA_PATH=data/predictions_reference.jsonl
# MODEL_DRIFT_CURRENT_DATA_PATH=data/predictions.jsonl
